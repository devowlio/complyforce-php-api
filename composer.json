{
  "name": "complyforce/api",
  "description": "PHP client for the Complyforce API",
  "keywords": [
    "swagger",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://complyforce.com",
  "license": "MIT",
  "authors": [
    {
      "name": "devowl.io GmbH",
      "homepage": "https://devowl.io"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "DevOwl\\ComplyforceApiClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DevOwl\\ComplyforceApiClient\\": "test/"
    }
  },
  "majorOpenApiSpecVersion": "v1",
  "publishVersion": "1.10.9"
}
